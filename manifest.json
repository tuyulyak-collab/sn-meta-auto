{
  "manifest_version": 3,
  "name": "SN Stock Keyword Optimizer",
  "short_name": "SN Stock Optimizer",
  "version": "1.0.0",
  "description": "Scan, analyze, clean, and reorder Adobe Stock keywords with a local heuristic scorer. Relevance & competition helper (not a sales predictor).",
  "action": {
    "default_title": "SN Stock Keyword Optimizer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://contributor.stock.adobe.com/*",
    "https://*.stock.adobe.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://contributor.stock.adobe.com/*",
        "https://*.stock.adobe.com/*"
      ],
      "js": ["scripts/contentScript.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
